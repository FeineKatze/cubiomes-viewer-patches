+std::vector<Condition> FormConditions::getMapConditions() const
+{
+    std::vector<Condition> conds;
+
+    for (int i = 0, ie = ui->listConditions->count(); i < ie; i++)
+    {
+        const QListWidgetItem *item = ui->listConditions->item(i);
+        if (item->checkState() == Qt::Checked)
+            conds.push_back(qvariant_cast<Condition>(item->data(Qt::UserRole)));
+    }
+    return conds;
+}
