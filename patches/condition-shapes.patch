+void FormConditions::conditionsToggleMap()
+{
+    const QList<QListWidgetItem*> selected = ui->listConditions->selectedItems();
+    bool allshown = !selected.isEmpty();
+    for (const QListWidgetItem *item : selected)
+        allshown &= item->checkState() == Qt::Checked;
+    for (QListWidgetItem *item : selected)
+        item->setCheckState(allshown ? Qt::Unchecked : Qt::Checked);
+}
