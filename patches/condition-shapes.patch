+
+static Pos getSpawnPos(const WorldInfo& wi)
+{   // same generator settings as the map, so this is where the spawn icon is
+    static struct { bool valid; uint64_t seed; int mc, large; Pos p; } cache = {};
+    if (!cache.valid || cache.seed != wi.seed || cache.mc != wi.mc || cache.large != wi.large)
+    {
+        Generator g;
+        setupGenerator(&g, wi.mc, wi.large | FORCE_OCEAN_VARIANTS);
+        applySeed(&g, DIM_OVERWORLD, wi.seed);
+        cache.p = getSpawn(&g);
+        cache.seed = wi.seed;
+        cache.mc = wi.mc;
+        cache.large = wi.large;
+        cache.valid = true;
+    }
+    return cache.p;
+}
