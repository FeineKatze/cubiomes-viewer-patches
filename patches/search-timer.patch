+qint64 FormSearchControl::runTimeMs() const
+{
+    return runMs + (runTimer.isValid() ? runTimer.elapsed() : 0);
+}
+
+QString FormSearchControl::runTimeText() const
+{
+    qint64 s = runTimeMs() / 1000;
+    qint64 d = s / 86400;
+    qint64 h = s % 86400 / 3600;
+    qint64 m = s % 3600 / 60;
+    if (d)
+        return QString::asprintf("%lldd %02lld:%02lld:%02lld", (long long)d, (long long)h, (long long)m, (long long)(s % 60));
+    return QString::asprintf("%lld:%02lld:%02lld", (long long)h, (long long)m, (long long)(s % 60));
+}
+
+void FormSearchControl::updateIdleStatus()
+{
+    // same position as the clock of a running search, so the text does not jump
+    ui->labelStatus->setText(runTimeText() + "  |  " + tr("Idle", "Progressbar"));
+}
