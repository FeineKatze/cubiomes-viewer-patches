+uint64_t calcFitness(const Generator *g, int x, int z)
+{
+    int64_t np[6];
+    uint32_t flags = SAMPLE_NO_DEPTH | SAMPLE_NO_BIOME;
+    sampleBiomeNoise(&g->bn, np, x>>2, 0, z>>2, NULL, flags);
