+
+// Same result as calcFitness() whenever that is below 'best'; otherwise returns
+// 'best'. Climate parameters are only sampled while the candidate can still win,
+// since every parameter adds a non-negative term to the fitness.
+static
+uint64_t calcFitnessBelow(const Generator *g, int x, int z, uint64_t best)
+{
+    const BiomeNoise *bn = &g->bn;
+    // lower bound from the distance term alone (all parameters inside their ranges)
+    int64_t np[6] = { 0, 0, 0, 0, 0, -5000 };
+    if (fitnessFromNp(g, x, z, np) >= best)
+        return best;
+
+    int sx = x >> 2, sz = z >> 2;
+    double px = sx, pz = sz;
+    px += sampleDoublePerlin(&bn->climate[NP_SHIFT], sx, 0, sz) * 4.0;
+    pz += sampleDoublePerlin(&bn->climate[NP_SHIFT], sz, sx, 0) * 4.0;
+    float c = sampleDoublePerlin(&bn->climate[NP_CONTINENTALNESS], px, 0, pz);
+    float w = sampleDoublePerlin(&bn->climate[NP_WEIRDNESS], px, 0, pz);
+    np[2] = (int64_t)(10000.0F*c);
+    np[5] = (int64_t)(10000.0F*w);
+    if (fitnessFromNp(g, x, z, np) >= best)
+        return best;
+
+    float e = sampleDoublePerlin(&bn->climate[NP_EROSION], px, 0, pz);
+    float t = sampleDoublePerlin(&bn->climate[NP_TEMPERATURE], px, 0, pz);
+    float h = sampleDoublePerlin(&bn->climate[NP_HUMIDITY], px, 0, pz);
+    np[0] = (int64_t)(10000.0F*t);
+    np[1] = (int64_t)(10000.0F*h);
+    np[3] = (int64_t)(10000.0F*e);
+    return fitnessFromNp(g, x, z, np);
+}
