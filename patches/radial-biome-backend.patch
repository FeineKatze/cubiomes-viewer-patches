+// true if the cell (x,z) of the given range lies outside the circular area
+static inline int cell_outside(Range r, Pos at, int64_t rmaxsq, int x, int z)
+{
+    if (!rmaxsq)
+        return 0;
+    int64_t dx = (int64_t)x * r.scale - at.x;
+    int64_t dz = (int64_t)z * r.scale - at.z;
+    return dx*dx + dz*dz >= rmaxsq;
+}
