+// Evaluates up to four candidates in order, with the same outcome as calling
+// calcFitnessBelow() for each of them in sequence (the shift, continentalness
+// and weirdness noise is computed for all four at once).
+static
+void fittestBatch(const Generator *g, Pos *pos, uint64_t *fitness,
+    const int xs[4], const int zs[4], int n)
+{
+    const BiomeNoise *bn = &g->bn;
+    const int64_t np0[6] = { 0, 0, 0, 0, 0, -5000 };
+    int active = 0, l;
+    for (l = 0; l < n; l++)
+        active |= fitnessFromNp(g, xs[l], zs[l], np0) < *fitness;
+    if (!active)
+        return;
+
+    double px[4], pz[4], xd[4], zd[4], zero[4] = {0, 0, 0, 0}, s1[4], s2[4], v[4];
+    float c[4], w[4];
+    for (l = 0; l < 4; l++)
+    {
+        int k = l < n ? l : n - 1;
+        xd[l] = px[l] = xs[k] >> 2;
+        zd[l] = pz[l] = zs[k] >> 2;
+    }
+    sampleDoublePerlin4(&bn->climate[NP_SHIFT], xd, zero, zd, s1);
+    sampleDoublePerlin4(&bn->climate[NP_SHIFT], zd, xd, zero, s2);
+    for (l = 0; l < 4; l++)
+    {
+        px[l] += s1[l] * 4.0;
+        pz[l] += s2[l] * 4.0;
+    }
+    sampleDoublePerlin4(&bn->climate[NP_CONTINENTALNESS], px, zero, pz, v);
+    for (l = 0; l < 4; l++) c[l] = v[l];
+    sampleDoublePerlin4(&bn->climate[NP_WEIRDNESS], px, zero, pz, v);
+    for (l = 0; l < 4; l++) w[l] = v[l];
+
+    for (l = 0; l < n; l++)
+    {
+        int64_t np[6] = { 0, 0, 0, 0, 0, 0 };
+        np[2] = (int64_t)(10000.0F*c[l]);
+        np[5] = (int64_t)(10000.0F*w[l]);
+        if (fitnessFromNp(g, xs[l], zs[l], np) >= *fitness)
+            continue;
+        float e = sampleDoublePerlin(&bn->climate[NP_EROSION], px[l], 0, pz[l]);
+        float t = sampleDoublePerlin(&bn->climate[NP_TEMPERATURE], px[l], 0, pz[l]);
+        float h = sampleDoublePerlin(&bn->climate[NP_HUMIDITY], px[l], 0, pz[l]);
+        np[0] = (int64_t)(10000.0F*t);
+        np[1] = (int64_t)(10000.0F*h);
+        np[3] = (int64_t)(10000.0F*e);
+        uint64_t fit = fitnessFromNp(g, xs[l], zs[l], np);
+        if (fit < *fitness)
+        {
+            pos->x = xs[l];
+            pos->z = zs[l];
+            *fitness = fit;
+        }
+    }
+}
