 // Note: Climate noise is sampled at a 1:1 scale.
+// climate parameters of four positions, bit-identical to sampleBiomeNoise()
+static void sampleBiomeNoiseNP4(const BiomeNoise *bn, int64_t np[4][6],
+    const int x[4], const int y[4], const int z[4], uint32_t sample_flags)
+{
+    double px[4], pz[4], zero[4] = {0, 0, 0, 0}, xd[4], zd[4], v[4];
+    float t[4], h[4], c[4], e[4], d[4], w[4];
+    int l;
+    for (l = 0; l < 4; l++)
+    {
+        xd[l] = px[l] = x[l];
+        zd[l] = pz[l] = z[l];
+        d[l] = 0;
+    }
+    if (!(sample_flags & SAMPLE_NO_SHIFT))
+    {
+        double s1[4], s2[4];
+        sampleDoublePerlin4(&bn->climate[NP_SHIFT], xd, zero, zd, s1);
+        sampleDoublePerlin4(&bn->climate[NP_SHIFT], zd, xd, zero, s2);
+        for (l = 0; l < 4; l++)
+        {
+            px[l] += s1[l] * 4.0;
+            pz[l] += s2[l] * 4.0;
+        }
+    }
+
+    sampleDoublePerlin4(&bn->climate[NP_CONTINENTALNESS], px, zero, pz, v);
+    for (l = 0; l < 4; l++) c[l] = v[l];
+    sampleDoublePerlin4(&bn->climate[NP_EROSION], px, zero, pz, v);
+    for (l = 0; l < 4; l++) e[l] = v[l];
+    sampleDoublePerlin4(&bn->climate[NP_WEIRDNESS], px, zero, pz, v);
+    for (l = 0; l < 4; l++) w[l] = v[l];
+
+    if (!(sample_flags & SAMPLE_NO_DEPTH))
+    {
+        for (l = 0; l < 4; l++)
+        {
+            float np_param[] = {
+                c[l], e[l], peaksAndValleys(w[l]), w[l],
+            };
+            double off = getSpline(bn->sp, np_param) + 0.015F;
+            d[l] = 1.0 - (y[l] * 4) / 128.0 - 83.0/160.0 + off;
+        }
+    }
+
+    sampleDoublePerlin4(&bn->climate[NP_TEMPERATURE], px, zero, pz, v);
+    for (l = 0; l < 4; l++) t[l] = v[l];
+    sampleDoublePerlin4(&bn->climate[NP_HUMIDITY], px, zero, pz, v);
+    for (l = 0; l < 4; l++) h[l] = v[l];
+
+    for (l = 0; l < 4; l++)
+    {
+        np[l][0] = (int64_t)(10000.0F*t[l]);
+        np[l][1] = (int64_t)(10000.0F*h[l]);
+        np[l][2] = (int64_t)(10000.0F*c[l]);
+        np[l][3] = (int64_t)(10000.0F*e[l]);
+        np[l][4] = (int64_t)(10000.0F*d[l]);
+        np[l][5] = (int64_t)(10000.0F*w[l]);
+    }
+}
