+#include "noise_simd.h"
+
+int g_noiseSimd = 1;
+
+#if defined(__x86_64__) && defined(__GNUC__) && !defined(CUBIOMES_NO_SIMD)
+
+#include <immintrin.h>
+
+#define AVX2 __attribute__((target("avx2")))
+
+int noiseSimdAvailable(void)
+{
+    static int avail = -1;
+    if (avail < 0)
+    {
+        __builtin_cpu_init();
+        avail = __builtin_cpu_supports("avx2") ? 1 : 0;
+    }
+    return avail;
+}
+
+// per-gradient-index flags, bit i is set for index i (see indexedLerp)
+#define G_X1_IS_B 0xAF00u   // first operand is b instead of a: 8,9,10,11,13,15
+#define G_X2_IS_B 0x500Fu   // second operand is b instead of c: 0,1,2,3,12,14
+#define G_NEG1    0xEAAAu   // first term negated: 1,3,5,7,9,11,13,14,15
+#define G_NEG2    0x8CCCu   // second term negated: 2,3,6,7,10,11,15
+
+AVX2 static inline __m256d lanemask(__m128i idx, unsigned bits)
+{
+    __m128i sh = _mm_srlv_epi32(_mm_set1_epi32((int)bits), idx);
+    sh = _mm_and_si128(sh, _mm_set1_epi32(1));
+    sh = _mm_sub_epi32(_mm_setzero_si128(), sh); // 0 or -1
+    return _mm256_castsi256_pd(_mm256_cvtepi32_epi64(sh));
+}
+
+AVX2 static inline __m256d grad4(__m128i idx, __m256d a, __m256d b, __m256d c)
+{
+    idx = _mm_and_si128(idx, _mm_set1_epi32(15));
+    const __m256d sign = _mm256_set1_pd(-0.0);
+    __m256d x1 = _mm256_blendv_pd(a, b, lanemask(idx, G_X1_IS_B));
+    __m256d x2 = _mm256_blendv_pd(c, b, lanemask(idx, G_X2_IS_B));
+    x1 = _mm256_xor_pd(x1, _mm256_and_pd(sign, lanemask(idx, G_NEG1)));
+    x2 = _mm256_xor_pd(x2, _mm256_and_pd(sign, lanemask(idx, G_NEG2)));
+    return _mm256_add_pd(x1, x2);
+}
+
+AVX2 static inline __m256d fade4(__m256d d)
+{   // d*d*d * (d * (d*6.0-15.0) + 10.0)
+    __m256d cube = _mm256_mul_pd(_mm256_mul_pd(d, d), d);
+    __m256d in = _mm256_sub_pd(_mm256_mul_pd(d, _mm256_set1_pd(6.0)), _mm256_set1_pd(15.0));
+    in = _mm256_add_pd(_mm256_mul_pd(d, in), _mm256_set1_pd(10.0));
+    return _mm256_mul_pd(cube, in);
+}
+
+AVX2 static inline __m256d lerp4(__m256d t, __m256d from, __m256d to)
+{   // from + t * (to - from)
+    return _mm256_add_pd(from, _mm256_mul_pd(t, _mm256_sub_pd(to, from)));
+}
+
+AVX2 static inline __m256d samplePerlin4(const PerlinNoise *noise,
+        __m256d d1, __m256d d2, __m256d d3)
+{
+    d1 = _mm256_add_pd(d1, _mm256_set1_pd(noise->a));
+    d2 = _mm256_add_pd(d2, _mm256_set1_pd(noise->b));
+    d3 = _mm256_add_pd(d3, _mm256_set1_pd(noise->c));
+    __m256d i1 = _mm256_floor_pd(d1);
+    __m256d i2 = _mm256_floor_pd(d2);
+    __m256d i3 = _mm256_floor_pd(d3);
+    d1 = _mm256_sub_pd(d1, i1);
+    d2 = _mm256_sub_pd(d2, i2);
+    d3 = _mm256_sub_pd(d3, i3);
+    __m256d t1 = fade4(d1), t2 = fade4(d2), t3 = fade4(d3);
+
+    int h1[4], h2[4], h3[4];
+    _mm_storeu_si128((__m128i*)h1, _mm256_cvttpd_epi32(i1));
+    _mm_storeu_si128((__m128i*)h2, _mm256_cvttpd_epi32(i2));
+    _mm_storeu_si128((__m128i*)h3, _mm256_cvttpd_epi32(i3));
+
+    const uint8_t *idx = noise->d;
+    int g[8][4]; // gradient indices: l1,l5 | l2,l6 | l3,l7 | l4,l8 order below
+    for (int l = 0; l < 4; l++)
+    {
+        uint8_t a1 = (uint8_t)h1[l], y = (uint8_t)h2[l], z = (uint8_t)h3[l];
+        uint8_t va = idx[a1] + y, vb = idx[(uint8_t)(a1)+1] + y;
+        // v2 from va, v3 from vb
+        uint8_t v2a = idx[va] + z, v2b = idx[va+1] + z;
+        uint8_t v3a = idx[vb] + z, v3b = idx[vb+1] + z;
+        g[0][l] = idx[v2a];     g[1][l] = idx[v2a+1];   // l1, l5
+        g[2][l] = idx[v3a];     g[3][l] = idx[v3a+1];   // l2, l6
+        g[4][l] = idx[v2b];     g[5][l] = idx[v2b+1];   // l3, l7
+        g[6][l] = idx[v3b];     g[7][l] = idx[v3b+1];   // l4, l8
+    }
+
+    const __m256d one = _mm256_set1_pd(1.0);
+    __m256d d1m = _mm256_sub_pd(d1, one);
+    __m256d d2m = _mm256_sub_pd(d2, one);
+    __m256d d3m = _mm256_sub_pd(d3, one);
+#define G(k) _mm_loadu_si128((const __m128i*)g[k])
+    __m256d l1 = grad4(G(0), d1,  d2,  d3);
+    __m256d l5 = grad4(G(1), d1,  d2,  d3m);
+    __m256d l2 = grad4(G(2), d1m, d2,  d3);
+    __m256d l6 = grad4(G(3), d1m, d2,  d3m);
+    __m256d l3 = grad4(G(4), d1,  d2m, d3);
+    __m256d l7 = grad4(G(5), d1,  d2m, d3m);
+    __m256d l4 = grad4(G(6), d1m, d2m, d3);
+    __m256d l8 = grad4(G(7), d1m, d2m, d3m);
+#undef G
+    l1 = lerp4(t1, l1, l2);
+    l3 = lerp4(t1, l3, l4);
+    l5 = lerp4(t1, l5, l6);
+    l7 = lerp4(t1, l7, l8);
+    l1 = lerp4(t2, l1, l3);
+    l5 = lerp4(t2, l5, l7);
+    return lerp4(t3, l1, l5);
+}
+
+AVX2 static __m256d sampleOctave4(const OctaveNoise *noise, __m256d x, __m256d y, __m256d z)
+{
+    __m256d v = _mm256_setzero_pd();
+    for (int i = 0; i < noise->octcnt; i++)
+    {
+        const PerlinNoise *p = noise->octaves + i;
+        __m256d lf = _mm256_set1_pd(p->lacunarity);
+        __m256d pv = samplePerlin4(p, _mm256_mul_pd(x, lf), _mm256_mul_pd(y, lf), _mm256_mul_pd(z, lf));
+        v = _mm256_add_pd(v, _mm256_mul_pd(_mm256_set1_pd(p->amplitude), pv));
+    }
+    return v;
+}
+
+AVX2 void sampleDoublePerlin4(const DoublePerlinNoise *noise,
+        const double x[4], const double y[4], const double z[4], double out[4])
+{
+    const __m256d f = _mm256_set1_pd(337.0 / 331.0);
+    __m256d vx = _mm256_loadu_pd(x), vy = _mm256_loadu_pd(y), vz = _mm256_loadu_pd(z);
+    __m256d v = _mm256_setzero_pd();
+    v = _mm256_add_pd(v, sampleOctave4(&noise->octA, vx, vy, vz));
+    v = _mm256_add_pd(v, sampleOctave4(&noise->octB, _mm256_mul_pd(vx, f), _mm256_mul_pd(vy, f), _mm256_mul_pd(vz, f)));
+    _mm256_storeu_pd(out, _mm256_mul_pd(v, _mm256_set1_pd(noise->amplitude)));
+}
