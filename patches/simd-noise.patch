+void sampleBiomeNoise4(const BiomeNoise *bn, int ids[4], const int x[4],
+    const int y[4], const int z[4], int n, uint64_t *dat, uint32_t sample_flags)
+{
+    int l;
+    if (n < 2 || bn->nptype >= 0 || !useNoiseSimd())
+    {
+        for (l = 0; l < n; l++)
+            ids[l] = sampleBiomeNoise(bn, NULL, x[l], y[l], z[l], dat, sample_flags);
+        return;
+    }
+    int xs[4], ys[4], zs[4];
+    int64_t np[4][6];
+    for (l = 0; l < 4; l++)
+    {   // pad unused lanes with the last valid position
+        int k = l < n ? l : n - 1;
+        xs[l] = x[k]; ys[l] = y[k]; zs[l] = z[k];
+    }
+    sampleBiomeNoiseNP4(bn, np, xs, ys, zs, sample_flags);
+    for (l = 0; l < n; l++)
+    {
+        int id = none;
+        if (!(sample_flags & SAMPLE_NO_BIOME))
+            id = climateToBiome(bn->mc, (const uint64_t*)np[l], dat);
+        ids[l] = id;
+    }
+}
