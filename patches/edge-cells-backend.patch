+    int64_t x0 = (int64_t)x * r.scale, z0 = (int64_t)z * r.scale;
+    int64_t dx, dz;
+    if (touch)
+    {
+        int64_t x1 = x0 + r.scale - 1, z1 = z0 + r.scale - 1;
+        dx = at.x < x0 ? x0 - at.x : at.x > x1 ? at.x - x1 : 0;
+        dz = at.z < z0 ? z0 - at.z : at.z > z1 ? at.z - z1 : 0;
+    }
+    else
+    {
+        dx = x0 - at.x;
+        dz = z0 - at.z;
+    }
     return dx*dx + dz*dz >= rmaxsq;
 }
 
