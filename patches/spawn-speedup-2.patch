+#if defined(__GNUC__)
+// The candidate offsets of the two rings do not depend on the seed: compute them
+// once per thread, with the same expressions as before.
+#define RING_MAX 1100
+typedef struct { int state, n; int dx[RING_MAX], dz[RING_MAX]; } RingTable;
+static __thread RingTable ring_tbl[2];
+static const RingTable *getRing(double maxrad, double step)
+{
+    int k = (maxrad == 2048.0 && step == 512.0) ? 0 : (maxrad == 512.0 && step == 32.0) ? 1 : -1;
+    if (k < 0)
+        return NULL;
+    RingTable *t = &ring_tbl[k];
+    if (t->state == 0)
+    {
+        int n = 0;
+        double rad, ang;
+        for (rad = step; rad <= maxrad; rad += step)
+        {
+            for (ang = 0; ang <= PI*2; ang += step/rad)
+            {
+                if (n >= RING_MAX) { t->state = -1; return NULL; }
+                t->dx[n] = (int)(sin(ang) * rad);
+                t->dz[n] = (int)(cos(ang) * rad);
+                n++;
+            }
+        }
+        t->n = n;
+        t->state = 1;
+    }
+    return t->state > 0 ? t : NULL;
+}
+#endif
+
+static inline
+void ringCandidate(const Generator *g, Pos *pos, uint64_t *fitness, int x, int z,
+    int batch, int bx[4], int bz[4], int *bn)
+{
+    if (batch)
+    {
+        // skip candidates that cannot win, so the vector lanes only hold useful ones.
+        // The best fitness only gets lower, so a candidate that cannot beat it now
+        // cannot beat it later either.
+        uint64_t lb;
+        if (g->mc > MC_1_21_1)
+            lb = (uint64_t)((int64_t)x*x + (int64_t)z*z);
+        else
+        {
+            const int64_t np0[6] = { 0, 0, 0, 0, 0, -5000 };
+            lb = fitnessFromNp(g, x, z, np0);
+        }
+        if (lb >= *fitness)
+            return;
+        bx[*bn] = x; bz[*bn] = z;
+        if (++*bn == 4)
+        {
+            fittestBatch(g, pos, fitness, bx, bz, *bn);
+            *bn = 0;
+        }
+        return;
+    }
+    uint64_t fit = g_fastSpawn ? calcFitnessBelow(g, x, z, *fitness)
+                               : calcFitness(g, x, z);
+    // Then update pos and fitness if combined total is lower/better
+    if (fit < *fitness)
+    {
+        pos->x = x;
+        pos->z = z;
+        *fitness = fit;
+    }
+}
